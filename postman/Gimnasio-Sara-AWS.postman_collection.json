      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Base de datos disponible\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
