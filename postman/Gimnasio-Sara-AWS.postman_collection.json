      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "ejercicioA",
      "value": "",
      "type": "string"
    },
    {
      "key": "ejercicioB",
      "value": "",
      "type": "string"
    },
