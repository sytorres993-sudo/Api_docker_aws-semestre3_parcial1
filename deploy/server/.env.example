# Copia este archivo a .env en EL SERVIDOR y completa los valores reales.
# Usa el endpoint DNS de RDS, sin https://, y el nombre de una base ya creada.
DB_URL='jdbc:postgresql://TU-ENDPOINT-RDS:5432/gimnasio?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem&connectTimeout=10'
DB_USER=TU_USUARIO_RDS
# Las comillas simples conservan literalmente $ y # en la contraseña.
# Si contiene una comilla simple, escápala con una barra: \'
DB_PASSWORD='TU_PASSWORD_RDS'
HTTP_PORT=80
